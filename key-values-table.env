# File format: This is NOT the standard dotenv file format.
# It is a simple key-value table using '=' as the separator.
# Each key-value pair must be on a separate line.
# Multiline values are not supported.
# Lines starting with '#' are treated as comments and ignored.
# Empty lines are ignored.
# Lines that do not contain an '=' character are ignored.
# Keys are case-sensitive.
# Everything after the first '=' character is treated as part of the value (including additional '=' characters and quotes).
# Leading and trailing whitespace is trimmed from both keys and values.
# (The behavior described above is defined by the process-templates.ps1 script.)

# Salesforce Org unique username (which you use to log in to Salesforce -- NOT the email). Example: o.kulychok@b2c-sfn-july.org
ORG_username=o.kulychok@b2c-sfn-july.org

# "Short Code" from BM>Administration > Site Development > Salesforce Commerce API Settings. Example: tkvkx39f
B2C_shortCode=tkvkx39f

# "Organization ID" from BM>Administration > Site Development > Salesforce Commerce API Settings. Example: f_ecom_zzpe_189
B2C_organizationId=f_ecom_zzpe_189

# Example: zzpe
B2C_realm=zzpe

# Example: 189
B2C_instance=189

# Example: zzpe-189
B2C_subdomain=zzpe-189

# Deployment URL. Search for hostname in BM>Administration > Sites > Storefront > [select site (MarketStreet)] > [select environment(marketstre-xxxxxxxx)] > eCDN Hostname
# MUST start with https://. Example: https://marketstreb1fcea6f7ff8554d.zzpe-189.my.commercecloud.salesforce.com
MRT_deploymentUrl=https://marketstreb1fcea6f7ff8554d.zzpe-189.my.commercecloud.salesforce.com

#The initial part of your sandbox URL between the protocol and path is the hostname.
B2C_hostName=zzpe-189.dx.commercecloud.salesforce.com

# sfcc siteId. Example: MarketStreet
B2C_siteId=MarketStreet

# Salesforce Org Id. Search in:  Salesforce > Setup > Company Information > [Salesforce.com Organization ID]
# Example: 00Dhm000002l5Gy
ORG_Id=00Dhm000002l5Gy